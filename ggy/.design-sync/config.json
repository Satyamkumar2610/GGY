{
  "pkg": "ggy",
  "globalName": "Ggy",
  "shape": "package",
  "buildCmd": "node .design-sync/ds/build.mjs",
  "entry": ".ds-dist/index.js",
  "cssEntry": "styles.css",
  "provider": {
    "component": "SiteShell"
  },
  "componentSrcMap": {
    "SiteShell": null,
    "MotionProvider": null,
    "SmoothScroll": null,
    "ScrollRefresh": null,
    "LandingMotion": null,
    "JournalMotion": null,
    "CinemaMotion": null,
    "PageMotion": null,
    "Interactions": null,
    "TicketMotion": null,
    "Card": null,
    "ScrollStackItem": null,
    "Thread": null,
    "ScrollProgress": null,
    "AtlasMap": null
  },
  "dtsPropsFor": {
    "Act": "  /** Anchor id for the section; also used for its heading id. */\n  id: string;\n  /** Roman numeral shown on the act label, e.g. \"II\". */\n  n: string;\n  title: string;\n  /** One-sentence standfirst under the title. */\n  dek: string;\n  /** Five keys of window.Ggy.photos (highCourt, municipalCorporation, oldSecretariat, sabarmati, gateway, bomJesus, cohort, openLandscape, lectureHall, overhead, fieldGroup, legislatureSteps, flagOff, address). The first is the full-bleed photograph. */\n  photos: [string, string, string, string, string];"
  },
  "overrides": {
    "LandingHero": {
      "cardMode": "single",
      "viewport": "1280x800"
    },
